# Environment Configuration
NODE_ENV=development

# Server Ports
USER_API_PORT=5001
ADMIN_API_PORT=5002
USER_WEB_PORT=3000
ADMIN_WEB_PORT=3001

# Databases
MONGO_URI=mongodb://localhost:27017/whasappbulk
REDIS_URL=redis://localhost:6379

# URLs
APP_URL=http://localhost:3000
USER_WEB_URL=http://localhost:3000
ADMIN_WEB_URL=http://localhost:3001
USER_API_URL=http://localhost:5001
ADMIN_API_URL=http://localhost:5002

# Authentication
JWT_SECRET=super_secret_jwt_key_enterprise_whatsapp_saas_2026_production_grade
JWT_REFRESH_SECRET=super_secret_jwt_refresh_key_enterprise_whatsapp_saas_2026
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Active WhatsApp Provider (mock | meta)
WHATSAPP_PROVIDER=mock

# Meta WhatsApp Cloud API Credentials (Leave empty for Mock provider)
META_APP_ID=
META_APP_SECRET=
META_CONFIG_ID=
META_ACCESS_TOKEN=
META_BUSINESS_ID=
META_WABA_ID=
META_PHONE_NUMBER_ID=
META_WEBHOOK_VERIFY_TOKEN=whatsapp_bulk_saas_verify_token_2026
META_API_VERSION=v20.0
ENCRYPTION_KEY=whatsapp_bulk_enterprise_encryption_key_32_bytes_safe!

# Payment Provider Credentials (mock | razorpay | stripe)
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email Provider (mock | sendgrid | smtp)
EMAIL_PROVIDER=mock
EMAIL_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=notifications@wappbiz.io

# Object Storage (mock | s3 | local)
STORAGE_PROVIDER=mock
STORAGE_BUCKET=whatsapp-saas-media
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=us-east-1

# Sentry & Monitoring (Optional)
SENTRY_DSN=

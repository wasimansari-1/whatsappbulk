# ==============================================================================
# WHATSAPP BULK SAAS — PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

NODE_ENV=production

# Server Ports (Behind Reverse Proxy / Nginx / Load Balancer)
USER_API_PORT=5001
ADMIN_API_PORT=5002
USER_WEB_PORT=3000
ADMIN_WEB_PORT=3001

# Production URLs (Replace with your registered domain)
APP_URL=https://app.yourdomain.com
USER_WEB_URL=https://app.yourdomain.com
ADMIN_WEB_URL=https://admin.yourdomain.com
USER_API_URL=https://api.yourdomain.com
ADMIN_API_URL=https://admin-api.yourdomain.com

# 1. MongoDB Atlas Production Replica Set (with TLS & Auth)
# Example: mongodb+srv://<db_user>:<db_password>@cluster0.abcde.mongodb.net/whasappbulk?retryWrites=true&w=majority&appName=WhatsAppSaaS
MONGO_URI=mongodb+srv://<db_user>:<db_password>@your-cluster.mongodb.net/whasappbulk?retryWrites=true&w=majority

# 2. Production Redis (Redis Cloud / Upstash / ElastiCache with Auth & TLS)
# Example: rediss://default:<password>@redis-12345.c1.us-east-1.redns.redis-cloud.com:12345
REDIS_URL=redis://:<redis_password>@your-production-redis-host:6379

# 3. Cryptographic Security Secrets (Min 32 characters each)
JWT_SECRET=production_jwt_secret_min_32_characters_long_enterprise_grade_key_2026
JWT_REFRESH_SECRET=production_jwt_refresh_secret_min_32_characters_long_enterprise_2026
ENCRYPTION_KEY=production_encryption_key_min_32_characters_for_aes_256_gcm!
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# 4. Meta Platform & SaaS App Credentials (App: IGlobalTechBulkSender)
WHATSAPP_PROVIDER=meta
META_APP_ID=1762437721674469
META_APP_SECRET=2e0e61bdbd5d13323ee4d8ad7ff722c0
META_WHATSAPP_CONFIG_ID=1037347322505824
META_GRAPH_API_VERSION=v25.0
META_WEBHOOK_VERIFY_TOKEN=whatsapp_bulk_saas_verify_token_2026

# Meta Permanent Webhook URL:
# https://api.yourdomain.com/api/whatsapp/webhook

# 5. Production Payment Gateways (Razorpay / Stripe)
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# 6. Production Transactional Email (SendGrid / Postmark / SMTP)
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your_sendgrid_api_key
SMTP_FROM="IGlobal Tech <noreply@yourdomain.com>"
